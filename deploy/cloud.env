# The cloud settings of riff (R144). The repository is public: put no
# account data here.
CLOUD_PROJECT=como-riff
CLOUD_PROJECT_NUMBER=816917641970
CLOUD_REGION=us-central1
CLOUD_SECRET=riff-oidc-client-secret
# The bucket that holds the state of riff-server (R30).
CLOUD_BUCKET=como-riff-state
# The Cloud Run service and its domain (R5, R6).
CLOUD_SERVICE=riff-server
CLOUD_DOMAIN=riff.comotechnologies.io
# riff-server runs as the first service account (R134). Cloud Build
# builds the image as the second.
CLOUD_RUN_ACCOUNT=riff-server
CLOUD_BUILD_ACCOUNT=riff-build
# CI deploys as the third account (R160, R161). It signs in from the
# GitHub repository with no key. It pushes images to the repository.
CLOUD_DEPLOY_ACCOUNT=riff-deploy
CLOUD_GITHUB_REPO=como-technologies/riff
CLOUD_REPOSITORY=riff
# `just oauth-client` writes the client ID here (R145).
RIFF_OIDC_CLIENT_ID=816917641970-3gn9duf91ovhma8q8ldm4rtpbk462aqn.apps.googleusercontent.com
