# The cloud settings of the shared riff (R144). `riff cloud` reads
# them by the name `shared`. The repository is public: put no account
# data here.
CLOUD_PROJECT=como-riff
CLOUD_PROJECT_NUMBER=816917641970
CLOUD_REGION=us-central1
CLOUD_SECRET=riff-oidc-client-secret
# The bucket that holds the state of riff-server (R30).
CLOUD_BUCKET=como-riff-state
# The Cloud Run service, its public URL and its domain (R5, R6). The
# public URL is the Cloud Run URL until the domain is ready. Then it
# is https://$CLOUD_DOMAIN, and `riff cloud deploy shared` maps the
# domain.
CLOUD_SERVICE=riff-server
CLOUD_DOMAIN=riff.comotechnologies.io
# The memory of the service (01M3TJWJEPTSF1S3S5PJD25Z7Y).
CLOUD_MEMORY=1Gi
# One instance runs at each time, also between calls
# (01M496JT648QS9WTE1QVHAJEE5).
CLOUD_MIN_INSTANCES=1
# The alert on each error in the log of the service, and the channel
# that sends it to the owner (01M3TJWJ6J3M6JRXJTAETZ5M6F).
CLOUD_ALERT=riff-server-errors
CLOUD_ALERT_CHANNEL=riff-owner
CLOUD_URL=https://riff-server-816917641970.us-central1.run.app
# riff-server runs as the first service account (R134). Cloud Build
# builds the image as the second.
CLOUD_RUN_ACCOUNT=riff-server
CLOUD_BUILD_ACCOUNT=riff-build
# CI deploys as the third account (01M3NJAZ6BYH7TWKDYTVEK78PG,
# 01M3NJAZAQ3AKMAM0EGM7R3S89). It signs in from the
# GitHub repository with no key. It pushes images to the repository.
CLOUD_DEPLOY_ACCOUNT=riff-deploy
CLOUD_GITHUB_REPO=como-technologies/riff
# Only a CI job in this GitHub environment signs in as the deploy
# account. The environment waits for the approval of the owner
# (01M49M8W30M2084QN4HX1FJFKS).
CLOUD_GITHUB_ENVIRONMENT=production
CLOUD_REPOSITORY=riff
# Other repositories use the shared riff: a deploy asks for the name
# (01M4262DVY8QCSZS61VDQ61SB3).
CLOUD_CONFIRM=true
# `riff cloud signin shared` writes the client ID here (R145).
RIFF_OIDC_CLIENT_ID=816917641970-3gn9duf91ovhma8q8ldm4rtpbk462aqn.apps.googleusercontent.com
# The GitHub App of riff (its ID and its private key) is in this
# secret. `riff forge create` puts it there (#627).
CLOUD_FORGE_SECRET=riff-forge-app-key
