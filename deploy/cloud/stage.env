# The cloud settings of the stage: a second riff-server, for the
# rehearsal of a release (01M496JTN962N0AX378MA1MBPM). `riff cloud`
# reads them by the name `stage`. The stage shares the project and the
# image repository of the releases with the shared riff. It has its own
# service, bucket, accounts, sign-in client and secret, so it holds no
# data of the shared riff. No setting here names the bucket, the
# service or the secret of the shared riff (a test in
# crates/riff/tests/cloud.rs proves it). The repository is public: put
# no account data here.
CLOUD_PROJECT=como-riff
CLOUD_PROJECT_NUMBER=816917641970
CLOUD_REGION=us-central1
CLOUD_SECRET=riff-stage-oidc-client-secret
CLOUD_BUCKET=como-riff-stage-state
CLOUD_SERVICE=riff-stage
# The stage has no domain.
CLOUD_DOMAIN=
CLOUD_MEMORY=1Gi
# The stage scales to zero between calls (01M496JT648QS9WTE1QVHAJEE5).
CLOUD_MIN_INSTANCES=0
# The stage has no alert.
CLOUD_ALERT=
CLOUD_ALERT_CHANNEL=
CLOUD_URL=https://riff-stage-816917641970.us-central1.run.app
CLOUD_RUN_ACCOUNT=riff-stage-server
CLOUD_BUILD_ACCOUNT=riff-stage-build
# CI deploys each merge to main to the stage as this account
# (01M496JT94NQ686GVSY5CCGZK7).
CLOUD_DEPLOY_ACCOUNT=riff-stage-deploy
CLOUD_GITHUB_REPO=como-technologies/riff
# Only a CI job in this GitHub environment signs in as the deploy
# account (01M49M8W30M2084QN4HX1FJFKS).
CLOUD_GITHUB_ENVIRONMENT=stage
# `riff cloud deploy stage TAG` deploys the image of the tag from here.
CLOUD_REPOSITORY=riff
CLOUD_CONFIRM=false
# `riff cloud signin stage` writes the client ID here.
RIFF_OIDC_CLIENT_ID=
# The private key of the GitHub App of riff is in this secret (#628).
# `riff cloud forge NAME APP_ID KEY` stores it and writes the App ID.
CLOUD_FORGE_SECRET=riff-stage-forge-app-key
RIFF_FORGE_APP=
